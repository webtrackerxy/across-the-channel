{
  "name": "channel-crossings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:build": "python3 scripts/build_data.py",
    "data:check": "python3 scripts/build_data.py --check",
    "narration:transcript": "vite-node scripts/narration.ts transcript",
    "narration:build": "vite-node scripts/narration.ts build",
    "narration:check": "vite-node scripts/narration.ts check",
    "narration:cache:prune": "vite-node scripts/narration.ts prune",
    "check": "yarn data:check && yarn narration:check && yarn format:check && yarn test && yarn build && yarn test:e2e",
    "format": "prettier --write src tests 'scripts/**/*.ts' vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests 'scripts/**/*.ts' vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-node": "3.2.4",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "packageManager": "yarn@1.22.22"
}
